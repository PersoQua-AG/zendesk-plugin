{
  "name": "zendesk-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "zendesk-authorize": "dist/bin/authorize.js",
    "zendesk-remote": "dist/bin/remote.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/plugin/stdio.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/plugin/server.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "check:executors": "node scripts/assert-executor-safety.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "authorize": "node dist/bin/authorize.js",
    "pack": "node scripts/validate-manifests.mjs && node scripts/assert-prod-tree.mjs && npx --yes @anthropic-ai/mcpb@2.1.2 pack . zendesk.mcpb && node scripts/audit-bundle.mjs zendesk.mcpb",
    "start:remote": "node dist/bin/remote.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
